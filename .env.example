# Database
DB_TYPE=faiss # or postgres
POSTGRES_URL=postgresql://user:password@localhost:5432/neuroclass

# Recognition Settings
# Calibrated on the 1,000-identity buffalo_s benchmark; validate again on local enrollment data.
ATTENDANCE_AUTO_THRESHOLD=0.45
ATTENDANCE_REVIEW_THRESHOLD=0.35
SIMILARITY_THRESHOLD=0.45
MIN_OBSERVATIONS=5
UNKNOWN_THRESHOLD=0.35

# API
API_HOST=0.0.0.0
API_PORT=8000

# Render AI service authentication
ENVIRONMENT=development
AI_SERVICE_SECRET=replace-with-a-long-random-secret

# Memory Optimization for Render Free (512MB RAM)
# Use buffalo_s for free tier, buffalo_l for local/GPU deployments
MODEL_NAME=buffalo_s
ONNX_PROVIDER=CPUExecutionProvider
MEMORY_OPTIMIZATION=true

REVIEW_THRESHOLD=0.35
MAX_PROFILE_EMBEDDINGS=50
LOG_LEVEL=INFO

# Supabase server-side configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
