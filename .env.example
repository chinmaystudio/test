# Database
DB_TYPE=faiss # or postgres
POSTGRES_URL=postgresql://user:password@localhost:5432/neuroclass

# Recognition Settings
SIMILARITY_THRESHOLD=0.5
MIN_OBSERVATIONS=5
UNKNOWN_THRESHOLD=0.4

# API
API_HOST=0.0.0.0
API_PORT=8000

# Render AI service authentication
ENVIRONMENT=development
AI_SERVICE_SECRET=replace-with-a-long-random-secret
MODEL_NAME=buffalo_l
REVIEW_THRESHOLD=0.45
MAX_PROFILE_EMBEDDINGS=50
LOG_LEVEL=INFO

# Supabase server-side configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
